    "Startet eine Aufnahme in Transcripts. Läuft schon eine, läuft sie weiter." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet eine Aufnahme in Transcripts. Läuft schon eine, läuft sie weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starts a recording in Transcripts. If one is already running, it keeps running."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lance un enregistrement dans Transcripts. Si un enregistrement est déjà en cours, il continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia una grabación en Transcripts. Si ya hay una en curso, sigue grabando."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia una registrazione in Transcripts. Se ce n’è già una in corso, continua."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia uma gravação no Transcripts. Se já houver uma em andamento, ela continua."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start een opname in Transcripts. Loopt er al een, dan loopt die door."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpoczyna nagrywanie w Transcripts. Jeśli nagranie już trwa, jest kontynuowane."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начинает запись в Transcripts. Если запись уже идёт, она продолжается."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Починає запис у Transcripts. Якщо запис уже йде, він триває."
          }
        }
      }
    },
