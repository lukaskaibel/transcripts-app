# Copy to fastlane/.env.secret and fill in. That file is gitignored; never commit it.

# App Store Connect API key: App Store Connect › Users and Access › Integrations › App Store Connect API.
# A team key with the App Manager or Admin role and access to certificates, identifiers and profiles: fastlane
# fetches the App Store profiles of the app and its widget extension with it. The Apple Distribution certificate has
# to be in this Mac's keychain.
APP_STORE_CONNECT_API_KEY_P8_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
APP_STORE_CONNECT_API_KEY_KEY_ID=XXXXXXXXXX
APP_STORE_CONNECT_API_KEY_ISSUER_ID=00000000-0000-0000-0000-000000000000

# The team the App Store builds are signed for. They always have iCloud sync, whatever Config/Local.xcconfig says.
DEVELOPMENT_TEAM=XXXXXXXXXX
