    "Parakeet läuft auf der Neural Engine dieses Macs und versteht 25 europäische Sprachen, auch gemischt. Nichts davon geht ins Internet." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parakeet läuft auf der Neural Engine dieses Macs und versteht 25 europäische Sprachen, auch gemischt. Nichts davon geht ins Internet."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parakeet работает на Neural Engine этого Mac и понимает 25 европейских языков, в том числе вперемешку. Ничего не отправляется в интернет."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parakeet funciona en el Neural Engine de este Mac y entiende 25 idiomas europeos, incluso mezclados. Nada sale a internet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Parakeet roda no Neural Engine deste Mac e entende 25 idiomas europeus, inclusive misturados. Nada disso vai para a internet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parakeet funziona sul Neural Engine di questo Mac e capisce 25 lingue europee, anche mescolate. Nulla viene inviato su internet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parakeet працює на Neural Engine цього Mac і розуміє 25 європейських мов, навіть упереміш. Нічого з цього не потрапляє в інтернет."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parakeet s’exécute sur le Neural Engine de ce Mac et comprend 25 langues européennes, même mélangées. Rien n’est envoyé sur Internet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parakeet draait op de Neural Engine van deze Mac en verstaat 25 Europese talen, ook door elkaar. Niets daarvan gaat naar het internet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parakeet runs on this Mac’s Neural Engine and understands 25 European languages, even mixed together. Nothing is sent over the internet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parakeet działa na Neural Engine tego Maca i rozumie 25 języków europejskich, także gdy się mieszają. Nic z tego nie trafia do internetu."
          }
        }
      }
    },
