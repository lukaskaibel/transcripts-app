    "Die Gesprächspartner waren zu schnell und doppelt zu hören. Die Meetings werden neu verarbeitet." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gesprächspartner waren zu schnell und doppelt zu hören. Die Meetings werden neu verarbeitet."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голоса собеседников звучали слишком быстро и дважды. Встречи будут обработаны заново."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los interlocutores se oían demasiado rápido y por duplicado. Las reuniones se volverán a procesar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os outros participantes soavam acelerados e duplicados. As reuniões serão processadas novamente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le voci della chiamata erano accelerate e doppie. Le riunioni vengono rielaborate."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Співрозмовників було чути надто швидко й подвійно. Зустрічі буде оброблено заново."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les interlocuteurs étaient accélérés et entendus en double. Les réunions vont être retraitées."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gesprekspartners waren te snel en dubbel te horen. De vergaderingen worden opnieuw verwerkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The other people on the call sounded too fast and could be heard twice. The meetings are being processed again."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Głosy rozmówców były przyspieszone i zdublowane. Spotkania zostaną przetworzone ponownie."
          }
        }
      }
    },
    "Die Personen und ihre Zuordnungen bleiben, aber die App erkennt niemanden mehr an der Stimme, bis sie neu gelernt hat." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Personen und ihre Zuordnungen bleiben, aber die App erkennt niemanden mehr an der Stimme, bis sie neu gelernt hat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Люди и их назначения сохранятся, но приложение перестанет узнавать кого-либо по голосу, пока не обучится заново."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las personas y sus asignaciones se mantienen, pero la app no reconocerá a nadie por la voz hasta que vuelva a aprender."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As pessoas e suas atribuições são mantidas, mas o app deixa de reconhecer qualquer pessoa pela voz até aprender de novo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le persone e le loro assegnazioni restano, ma l’app non riconoscerà più nessuno dalla voce finché non avrà imparato di nuovo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Люди та їхні призначення залишаться, але програма нікого не впізнаватиме за голосом, доки не навчиться знову."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les personnes et leurs attributions sont conservées, mais l’app ne reconnaîtra plus personne à la voix avant d’avoir réappris."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De personen en hun toewijzingen blijven behouden, maar niemand wordt meer aan de stem herkend tot de app de stemmen opnieuw heeft geleerd."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "People and their assignments stay, but the app won’t recognize anyone by voice until it has learned their voices again."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoby i ich przypisania pozostaną, ale aplikacja nie będzie nikogo rozpoznawać po głosie, dopóki nie nauczy się głosów od nowa."
          }
        }
      }
    },
