    "Meldet sich, wenn Zoom, Teams, Meet im Browser & Co. das Mikrofon benutzen, und wenn der Call vorbei ist, die Aufnahme aber noch läuft." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldet sich, wenn Zoom, Teams, Meet im Browser & Co. das Mikrofon benutzen, und wenn der Call vorbei ist, die Aufnahme aber noch läuft."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщает, когда Zoom, Teams, Meet в браузере и т. п. используют микрофон, а также когда звонок закончился, а запись ещё идёт."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisa cuando Zoom, Teams, Meet en el navegador y similares usan el micrófono, y cuando la llamada ha terminado pero la grabación sigue en curso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisa quando Zoom, Teams, Meet no navegador e afins usam o microfone, e quando a chamada termina mas a gravação continua."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti avvisa quando Zoom, Teams, Meet nel browser e simili usano il microfono, e quando la chiamata è finita ma la registrazione è ancora in corso."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сповіщає, коли Zoom, Teams, Meet у браузері тощо використовують мікрофон, а також коли дзвінок завершився, а запис іще триває."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous prévient lorsque Zoom, Teams, Meet dans le navigateur, etc. utilisent le micro, et lorsque l’appel est terminé mais que l’enregistrement continue."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geeft een melding wanneer Zoom, Teams, Meet in de browser enz. de microfoon gebruiken, en wanneer het gesprek voorbij is maar de opname nog loopt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets you know when Zoom, Teams, Meet in a browser, or similar apps use the microphone, and when a call is over but the recording is still running."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiadamia, gdy Zoom, Teams, Meet w przeglądarce i inne aplikacje używają mikrofonu, a także gdy rozmowa się skończyła, ale nagrywanie nadal trwa."
          }
        }
      }
    },
