    "Nach dem ersten Meeting erscheinen hier die Stimmen. Benenne sie einmal, dann erkennt die App sie in künftigen Meetings wieder." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem ersten Meeting erscheinen hier die Stimmen. Benenne sie einmal, dann erkennt die App sie in künftigen Meetings wieder."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После первой встречи здесь появятся голоса. Назовите их один раз — и приложение будет узнавать их на следующих встречах."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras la primera reunión, aquí aparecerán las voces. Ponles nombre una vez y la app las reconocerá en futuras reuniones."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois da primeira reunião, as vozes aparecem aqui. Dê um nome a elas uma vez, e o app as reconhecerá nas próximas reuniões."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo la prima riunione, qui compaiono le voci. Dai loro un nome una volta e l’app le riconoscerà nelle riunioni successive."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після першої зустрічі тут з’являться голоси. Дайте їм імена один раз, і програма впізнаватиме їх у майбутніх зустрічах."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les voix apparaîtront ici après la première réunion. Nommez-les une fois, et l’app les reconnaîtra dans les réunions suivantes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na de eerste vergadering verschijnen hier de stemmen. Geef ze één keer een naam, dan herkent de app ze in toekomstige vergaderingen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voices appear here after your first meeting. Name them once, and the app will recognize them in future meetings."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po pierwszym spotkaniu pojawią się tu głosy. Nazwij je raz, a aplikacja rozpozna je na kolejnych spotkaniach."
          }
        }
      }
    },
