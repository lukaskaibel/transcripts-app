    "Lernt bei jedem Anlegen dazu. Serien kommen aus dem Kalender, Runden aus den erkannten Stimmen." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lernt bei jedem Anlegen dazu. Serien kommen aus dem Kalender, Runden aus den erkannten Stimmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Learns with every issue you create. Series come from the calendar, the people from the voices it recognized."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apprend à chaque création d’issues. Les séries viennent du calendrier, les participants des voix reconnues."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprende con cada issue que creas. Las series vienen del calendario; las personas, de las voces reconocidas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impara ogni volta che crei delle issue. Le serie vengono dal calendario, le persone dalle voci riconosciute."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprende a cada issue criada. As séries vêm do calendário, e as pessoas, das vozes reconhecidas."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leert bij met elke issue die je aanmaakt. Reeksen komen uit de agenda, personen uit de herkende stemmen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uczy się przy każdym tworzeniu zgłoszeń. Serie pochodzą z kalendarza, a grona osób – z rozpoznanych głosów."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Навчається щоразу, коли ви створюєте тікети. Серії беруться з календаря, склад учасників — з упізнаних голосів."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение учится при каждом создании issue. Серии берутся из календаря, состав участников — из узнанных голосов."
          }
        }
      }
    },
