    "Noch keine Stimme. Ordne %@ in einem Meeting zu, dann erkennt die App die Stimme wieder." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Stimme. Ordne %@ in einem Meeting zu, dann erkennt die App die Stimme wieder."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голоса пока нет. Укажите на встрече, где говорит %@, — и приложение начнёт узнавать этот голос."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay ninguna voz. Asigna a %@ en una reunión y la app reconocerá su voz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda sem voz. Atribua uma voz a %@ em uma reunião para que o app a reconheça."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora nessuna voce. Assegna %@ a un interlocutore in una riunione e l’app ne riconoscerà la voce."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голосу ще немає. Призначте ім’я %@ мовцю в одній із зустрічей, і програма впізнаватиме цей голос."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
