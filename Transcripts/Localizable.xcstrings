    "Starte eine Aufnahme mit ⌘R oder über die Menüleiste. Du kannst auch eine Audiodatei hierher ziehen." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte eine Aufnahme mit ⌘R oder über die Menüleiste. Du kannst auch eine Audiodatei hierher ziehen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начните запись сочетанием клавиш ⌘R или через строку меню. Можно также перетащить сюда аудиофайл."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia una grabación con ⌘R o desde la barra de menús. También puedes arrastrar aquí un archivo de audio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie uma gravação com ⌘R ou pela barra de menus. Você também pode arrastar um arquivo de áudio para cá."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia una registrazione con ⌘R o dalla barra dei menu. Puoi anche trascinare qui un file audio."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Почніть запис за допомогою ⌘R або зі смуги меню. Також можна перетягнути сюди аудіофайл."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Démarrez un enregistrement avec ⌘R ou depuis la barre des menus. Vous pouvez aussi faire glisser un fichier audio ici."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start een opname met ⌘R of via de menubalk. Je kunt ook een audiobestand hierheen slepen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start a recording with ⌘R or from the menu bar. You can also drag an audio file here."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpocznij nagrywanie skrótem ⌘R lub z paska menu. Możesz też przeciągnąć tutaj plik audio."
          }
        }
      }
    },
