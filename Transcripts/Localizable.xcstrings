          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выкл. Если включить, модель будет составлять сводку разговора каждые полторы минуты."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado. Si lo activas, el modelo resume la conversación cada minuto y medio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado. Quando ativado, o modelo resume a conversa a cada minuto e meio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivato. Se attivo, il modello riassume la conversazione ogni minuto e mezzo."
          }
        },
        "uk" : {
