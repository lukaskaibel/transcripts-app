    "Transcripts legt Issues mit denselben Rechten an wie Issues for GitHub: Issues und Projekte deiner Repositories und Organisationen." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcripts legt Issues mit denselben Rechten an wie Issues for GitHub: Issues und Projekte deiner Repositories und Organisationen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcripts creates issues with the same access as Issues for GitHub: issues and projects of your repositories and organizations."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcripts crée des issues avec les mêmes autorisations qu’Issues for GitHub : issues et projets de vos dépôts et organisations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcripts crea issues con los mismos permisos que Issues for GitHub: issues y proyectos de tus repositorios y organizaciones."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcripts crea issue con gli stessi permessi di Issues for GitHub: issue e progetti dei tuoi repository e delle tue organizzazioni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Transcripts cria issues com as mesmas permissões do Issues for GitHub: issues e projetos dos seus repositórios e organizações."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcripts maakt issues aan met dezelfde rechten als Issues for GitHub: issues en projecten van je repository's en organisaties."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcripts tworzy zgłoszenia z tymi samymi uprawnieniami co Issues for GitHub: do zgłoszeń i projektów w twoich repozytoriach i organizacjach."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcripts створює тікети з тими самими правами, що й Issues for GitHub: тікети й проєкти ваших репозиторіїв та організацій."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcripts создаёт issue с теми же правами, что и Issues for GitHub: доступ к issue и проектам ваших репозиториев и организаций."
          }
        }
      }
    },
