    "Stell den Stil auf „Dauerhaft“, damit eine Erinnerung stehen bleibt, bis du „Aufnehmen“ klickst." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell den Stil auf „Dauerhaft“, damit eine Erinnerung stehen bleibt, bis du „Aufnehmen“ klickst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set the alert style to “Persistent” so a reminder stays on screen until you click “Record.”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez le style « Persistante » pour qu’un rappel reste affiché jusqu’à ce que vous cliquiez sur « Enregistrer »."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el estilo «Permanente» para que el aviso se quede en pantalla hasta que hagas clic en «Grabar»."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta lo stile su «Permanenti» perché il promemoria resti visibile finché non fai clic su «Registra»."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha o estilo “Persistente” para que um lembrete fique na tela até você clicar em “Gravar”."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel de stijl in op “Blijvend”, zodat een herinnering blijft staan tot je op “Neem op” klikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw styl „Stałe”, aby przypomnienie pozostało widoczne, dopóki nie klikniesz „Nagraj”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите стиль «Постоянно», чтобы напоминание оставалось на экране, пока вы не нажмёте «Записать»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть стиль «Постійно», щоб нагадування залишалося на екрані, доки ви не натиснете «Записати»."
          }
        }
      }
    },
