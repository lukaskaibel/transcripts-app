    "Noch nichts gemerkt. Sobald du Aufgaben nach GitHub schickst, merkt sich die App das Ziel für die Kalenderserie, den Titel und die Runde." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nichts gemerkt. Sobald du Aufgaben nach GitHub schickst, merkt sich die App das Ziel für die Kalenderserie, den Titel und die Runde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing remembered yet. Once you send action items to GitHub, the app remembers the place for the calendar series, the title and the people."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien de mémorisé pour l’instant. Dès que vous envoyez des tâches vers GitHub, l’app mémorise la destination pour la série du calendrier, le titre et les participants."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay nada recordado. En cuanto envíes tareas a GitHub, la app recordará el destino para la serie del calendario, el título y las personas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora niente di memorizzato. Quando invii attività a GitHub, l’app memorizza la destinazione per la serie del calendario, il titolo e le persone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada memorizado ainda. Quando você enviar tarefas para o GitHub, o app memoriza o destino para a série do calendário, o título e as pessoas."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog niets onthouden. Zodra je actiepunten naar GitHub stuurt, onthoudt de app de bestemming voor de agendareeks, de titel en de personen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic jeszcze nie zapamiętano. Gdy wyślesz zadania do GitHuba, aplikacja zapamięta miejsce docelowe dla serii wydarzeń, tytułu i grona osób."
          }
        },
        "uk" : {
