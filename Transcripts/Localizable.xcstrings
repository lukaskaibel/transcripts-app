    },
    "Transkripte und Zusammenfassungen bleiben immer erhalten; mit der Aufnahme kannst du Stellen nachhören und neu transkribieren." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transkripte und Zusammenfassungen bleiben immer erhalten; mit der Aufnahme kannst du Stellen nachhören und neu transkribieren."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расшифровки и сводки сохраняются всегда; по записи можно переслушать фрагменты и расшифровать их заново."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las transcripciones y los resúmenes se conservan siempre; con la grabación puedes volver a escuchar fragmentos y transcribirlos de nuevo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcrições e resumos são sempre mantidos; com a gravação, você pode ouvir trechos de novo e transcrever outra vez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascrizioni e riassunti restano sempre; con la registrazione puoi riascoltare dei passaggi e trascriverli di nuovo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Транскрипти й підсумки зберігаються завжди; із записом можна переслухати фрагменти й транскрибувати заново."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les transcriptions et les résumés sont toujours conservés ; l’enregistrement permet de réécouter des passages et de les retranscrire."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcripten en samenvattingen blijven altijd bewaard; met de opname kun je fragmenten terugluisteren en opnieuw transcriberen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcripts and summaries are always kept; the recording lets you replay passages and transcribe again."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transkrypcje i podsumowania są zawsze zachowywane; dzięki nagraniu możesz odsłuchać fragmenty i ponownie je przetranskrybować."
          }
        }
      }
    },
