    "%@ und %@ klingen deutlich verschieden. Wenn das zwei Personen sind, gib eine davon an die richtige weiter." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ und %@ klingen deutlich verschieden. Wenn das zwei Personen sind, gib eine davon an die richtige weiter."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ и %@ звучат совсем по-разному. Если это два разных человека, передайте один из голосов нужному человеку."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ y %@ suenan claramente distintas. Si son dos personas, asigna una de ellas a quien corresponda."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ e %@ soam bem diferentes. Se forem duas pessoas, passe uma delas para a pessoa certa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ e %@ hanno un timbro molto diverso. Se sono due persone, assegna una delle due a quella giusta."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ і %@ звучать зовсім по-різному. Якщо це дві різні людини, передайте один із голосів потрібній особі."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ et %@ sont très différentes à l’oreille. S’il s’agit de deux personnes, attribuez l’une d’elles à la bonne personne."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ en %@ klinken duidelijk verschillend. Als dit twee personen zijn, wijs er dan een toe aan de juiste persoon."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ and %@ sound clearly different. If they’re two people, give one of them to the right person."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ i %@ brzmią wyraźnie inaczej. Jeśli to dwie osoby, przypisz jeden z głosów właściwej osobie."
          }
        }
      }
    },
    "%@ und die Stimmerkennung, etwa 700 MB. Einmal laden, danach läuft alles offline." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ und die Stimmerkennung, etwa 700 MB. Einmal laden, danach läuft alles offline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ и распознавание голосов — около 700 МБ. Достаточно скачать один раз, дальше всё работает офлайн."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ y la identificación de voces, unos 700 MB. Se descargan una vez y luego todo funciona sin conexión."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ e o reconhecimento de vozes, cerca de 700 MB. Basta baixar uma vez; depois, tudo funciona offline."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ e il riconoscimento delle voci, circa 700 MB. Scaricali una volta, poi tutto funziona offline."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ і розпізнавання голосів — близько 700 МБ. Завантажте один раз, і далі все працюватиме без інтернету."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ et l’identification des voix, environ 700 Mo. Un seul téléchargement, puis tout fonctionne hors ligne."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ en stemherkenning, ongeveer 700 MB. Eén keer laden, daarna werkt alles offline."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ and voice recognition, about 700 MB. Download once, then everything runs offline."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ i rozpoznawanie głosów, ok. 700 MB. Wystarczy pobrać raz, potem wszystko działa offline."
          }
        }
      }
    },
