    "Transkript, Zusammenfassung und Aufnahme werden gelöscht." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transkript, Zusammenfassung und Aufnahme werden gelöscht."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расшифровка, сводка и запись будут удалены."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán la transcripción, el resumen y la grabación."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A transcrição, o resumo e a gravação serão apagados."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascrizione, riassunto e registrazione verranno eliminati."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Транскрипт, підсумок і запис буде видалено."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La transcription, le résumé et l’enregistrement seront supprimés."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcript, samenvatting en opname worden verwijderd."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The transcript, summary, and recording will be deleted."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transkrypcja, podsumowanie i nagranie zostaną usunięte."
          }
        }
      }
    },
    "Transkripte und Zusammenfassungen bleiben immer erhalten; mit der Aufnahme kannst du Stellen nachhören und neu transkribieren." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transkripte und Zusammenfassungen bleiben immer erhalten; mit der Aufnahme kannst du Stellen nachhören und neu transkribieren."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расшифровки и сводки сохраняются всегда; по записи можно переслушать фрагменты и расшифровать их заново."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las transcripciones y los resúmenes se conservan siempre; con la grabación puedes volver a escuchar fragmentos y transcribirlos de nuevo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcrições e resumos são sempre mantidos; com a gravação, você pode ouvir trechos de novo e transcrever outra vez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascrizioni e riassunti restano sempre; con la registrazione puoi riascoltare dei passaggi e trascriverli di nuovo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Транскрипти й підсумки зберігаються завжди; із записом можна переслухати фрагменти й транскрибувати заново."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les transcriptions et les résumés sont toujours conservés ; l’enregistrement permet de réécouter des passages et de les retranscrire."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
