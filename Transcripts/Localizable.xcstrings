    "Sobald jemand eine Stimme hat, zeigt die Karte, wie die Stimmen zueinander liegen." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobald jemand eine Stimme hat, zeigt die Karte, wie die Stimmen zueinander liegen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда у кого-то появится голос, карта покажет, как голоса расположены относительно друг друга."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cuanto alguien tenga una voz, el mapa mostrará cómo se sitúan las voces entre sí."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando alguém tiver uma voz, o mapa mostrará a proximidade entre as vozes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appena qualcuno ha una voce, la mappa mostra come si collocano le voci tra loro."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щойно в когось з’явиться голос, карта покаже, як голоси розташовані один щодо одного."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dès qu’une personne a une voix, la carte montre la proximité des voix entre elles."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zodra iemand een stem heeft, toont de kaart hoe de stemmen zich tot elkaar verhouden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once someone has a voice, the map shows how the voices relate to one another."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ktoś będzie miał głos, mapa pokaże, jak głosy układają się względem siebie."
          }
        }
      }
    },
